# Copy to /opt/clarify/.env on the server and fill in. Never commit the real .env.

CANRISK_USERNAME=
CANRISK_PASSWORD=
OPENAI_API_KEY=


# Code visitors must type before starting a conversation. Leave blank to disable.
ACCESS_CODE=
# Max simultaneous conversations (each one is a Python process).
MAX_SESSIONS=10
# Kill a conversation after this many seconds with no activity.
IDLE_TIMEOUT_SECONDS=1800
